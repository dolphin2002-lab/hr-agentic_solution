      "eval_id": "tier1_policy_rag_sick_leave",
      "conversation": [
        {
          "invocation_id": "inv-001",
          "user_content": {
            "role": "user",
            "parts": [
              {
                "text": "How many days of paid outpatient sick leave and hospitalization leave do full-time employees get in Singapore according to our handbook?"
              }
            ]
          },
          "final_response": {
            "role": "model",
            "parts": [
              {
                "text": "Full-time eligible employees in Singapore receive up to 14 days of paid outpatient sick leave and up to 60 days of paid hospitalization leave per calendar year (inclusive of the 14 outpatient days), per Section 25 of the ALTOSTRAT SINGAPORE EMPLOYEE POLICY HANDBOOK & CONDUCT GUIDELINES (gs://sales-demo-492804-hr-policies-source/handbook.pdf)."
              }
            ]
          },
          "intermediate_data": {
            "tool_uses": [
              {
                "name": "transfer_to_agent",
                "args": {
                  "agent_name": "rag_agent"
                }
              },
